import numpy as np
import cv2
import torch
import torchvision.transforms as transforms
import torchvision.models as models
from io import BytesIO
import requests
import time

yolo_model = torch.hub.load("ultralytics/yolov5", 'yolov5s', pretrained=True)
yolo_model.eval()

class_model = models.resnet50(pretrained=True)
class_model.eval()

device = 'cuda' if torch.cuda.is_available() else 'cpu'
class_model = class_model.to(device)

LABELS_URL = "https://raw.githubusercontent.com/anishathalye/imagenet-simple-labels/master/imagenet-simple-labels.json"
labels = requests.get(LABELS_URL).json()

transform = transforms.Compose([
    transforms.ToPILImage,
    transforms.Resize(256),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])

def predict_frame(frame):
    frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    img_tensor = transform(frame_rgb).unsqueeze(0).to(device)

    with torch.no_grad():
        outputs = class_model(img_tensor)

    probabilities = torch.nn.functional.softmax(outputs[0], dim=0)
    top_prob, top_idx = torch.max(probabilities, 0)

    top_class = labels[top_idx.item()]
    confidence = top_prob.item() * 100

    return top_class, confidence

def draw_text_with_bg(frame, text, position, font_scale=0.8, thickness=2):
    font = cv2.FONT_HERSHEY_COMPLEX
    (text_width, text_height), baseline = cv2.getTextSize(text, font, font_scale, thickness)
    x, y = position
    overlay = frame.copy()
    cv2.rectangle(overlay, (x - 10, y - text_height - 15), (x + text_width + 10, y + 5), (0, 0, 0), -1)
    cv2.addWeighted(overlay, 0.6, frame, 0.4, 0, frame)
    cv2.putText(frame, text, (x, y - 5), font, font_scale, (0, 255, 0), thickness)

def run_realtime_detection(cam_id=0, conf_th=0.3):
    cap = cv2.VideoCapture(cam_id)
    if not cap.isOpened():
        print("Camera opening error!")
        return

    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

    fps_start_time = time.time()
    fps_counter = 0
    fps = 0
    screenshot_counter = 0

    colors = [
        (255, 0, 0),
        (0, 255, 0),
        (0, 0, 255),
        (255, 0, 255),
        (255, 255, 0),
        (0, 255, 255)
    ]

    while True:
        ret, frame = cap.read()

        if not ret:
            print("Frame reading error!")
            break

        try:
            results = yolo_model(frame)
            detections = results.pandas().xyxy[0]

            for idx, detection in detections.iterrows():
                confidence = detection['confidence']
                if confidence < conf_th:
                    continue
                x1, y1, x2, y2 = int(detection["xmin"]), int(detection["ymin"]), int(detection["xmax"]), int(detection["ymax"])
                class_name = detection["name"]
                color = colors[idx % len(colors)]
                cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)
                label = f"{class_name}: {confidence:.2f}"
                (text_width, text_height), baseline = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.5, 2)
                cv2.rectangle(frame, (x1, y1 - text_height - 10), (x1 + text_width + 5, y1), color, -1)
                cv2.putText(frame, label, (x1 + 2, y1 - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)
        except Exception as err:
            print(f"Error: {err}")

        fps_counter += 1
        if time.time() - fps_start_time >= 1.0:
            fps = fps_counter
            fps_counter = 0
            fps_start_time = time.time()

        fps_text = f"FPS {fps}"
        (text_width, text_height), baseline = cv2.getTextSize(fps_text, cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2)
        cv2.rectangle(frame, (5, frame.shape[0] - 30), (15 + text_width, frame.shape[0] - 10), (0, 0, 0), -1)
        cv2.putText(frame, fps_text, (10, frame.shape[0] - 15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
        cv2.imshow("Detection objects with selecting", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()
    print("Work is done!")

if __name__ == "__main__":
    try:
        run_realtime_detection(cam_id=0, conf_th=0.3)
    except KeyboardInterrupt:
        print("Program has stopped by user!")
    except Exception as err:
        print(f"Error: {err}")

